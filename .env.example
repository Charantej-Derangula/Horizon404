# Copy this file to .env and fill in ONE of the two providers below.
# If neither is set, the API still runs, but docstrings/explanations/READMEs
# are generated in "mock" mode (clearly labeled placeholder output) so you
# can build and demo the UI without a paid key.

# Option 1: Anthropic (Claude) - checked first if both are set
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Option 2: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of origins allowed to call this API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
